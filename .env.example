# ==========================================
# REQUIRED SUPABASE VARIABLES
# ==========================================

# Your Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase Anon/Public Key (starts with eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Your Supabase Service Role Key (starts with eyJ...)
# !! WARNING: NEVER EXPOSE THIS TO THE CLIENT (Do not prefix with NEXT_PUBLIC) !!
# This is required for the Admin Dashboard to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=


# ==========================================
# REQUIRED TMDB (The Movie Database) VARIABLES
# ==========================================

# Your TMDB API Read Access Token (v4 auth)
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=


# ==========================================
# OPTIONAL VARIABLES (Will fallback to defaults if omitted)
# ==========================================

# Turnstile / reCAPTCHA Site Key for auth forms (if you enabled captcha)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Base URL used for generating default user avatars (Defaults to DiceBear)
NEXT_PUBLIC_AVATAR_PROVIDER_URL="https://api.dicebear.com/7.x/initials/svg?seed=user"

# Comma-separated list of paths that require authentication
PROTECTED_PATHS="/auth/reset-password,/profile"